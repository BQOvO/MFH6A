# BEGIN create-maa-project
node_modules/
.venv/
.uv-cache/
__pycache__/
config/
dist/
debug/
.create-maa-project/
# END create-maa-project


# MXU portable layout (local debug only, not tracked)
/mxu.exe
/maafw/
/MaaCommonAssets/
/cache/

# Runtime assets managed by `create-maa-project --update` (never committed)
/runtimes/
/plugins/
/libs/
resource/base/model/ocr/

# Local scratch space for one-off scripts, probes and debug output.
# Everything in here is disposable; only /scratch/README.md is tracked.
/scratch/*
!/scratch/README.md

# pnpm writes a local store into the project root unless store-dir is set.
/.pnpm-store/


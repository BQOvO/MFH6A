{
    "interface_version": 2,
    "name": "mfh6a",
    "label": "MFH6A",
    "version": "v0.0.0-dev",
    "description": "MFH6A MaaFW project",
    "controller": [
        {
            "name": "Windows",
            "label": "Forza Horizon 6 (窗口限定)",
            "type": "Win32",
            "display_short_side": 720,
            "permission_required": true,
            "win32": {
                "window_regex": "^[Ff]orza\\s+[Hh]orizon\\s+6",
                "class_regex": "^([Aa]pp|[Aa]pplicationFrameWindow|[Ff]orza[Hh]orizon6)$",
                "mouse": "PostMessageWithWindowPos",
                "keyboard": "PostMessage",
                "screencap": "FramePool"
            }
        }
    ],
    "resource": [
        {
            "name": "base",
            "label": "Steam端-后台",
            "path": [
                "./resource/base"
            ]
        }
    ],
    "agent": [
        {
            "child_exec": "uv",
            "child_args": [
                "run",
                "python",
                "agent/main.py"
            ]
        }
    ],
    "import": [
        "./tasks/tutorial.json"
    ]
}
